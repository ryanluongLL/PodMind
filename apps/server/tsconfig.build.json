{
  /// Production build for Render: compiles src into dist, leaving out tests,
  /// test helpers, the end to end server, and the Vitest configs, none of
  /// which run in production.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/integration/**", "src/testing/**", "src/e2e/**"]
}